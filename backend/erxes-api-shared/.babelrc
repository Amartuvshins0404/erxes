{
  "$schema": "https://json.schemastore.org/babelrc.json",
  "presets": [
    ["@babel/preset-env", { "targets": { "node": "24" } }],
    "@babel/preset-typescript"
  ],
  "plugins": [
    [
      "module-resolver",
      {
        "root": ["./"],
        "alias": {
          "@": "./src"
        }
      }
    ]
  ]
}
