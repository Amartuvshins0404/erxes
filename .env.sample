# --- Core ---
# NODE_ENV=development
# MONGO_URL=mongodb://localhost:27017/erxes
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REACT_APP_API_URL=http://localhost:4000
# NODE_OPTIONS=--max-old-space-size=1536
# ENABLED_PLUGINS=

# Gateway address used in emails. Set only when the gateway is not under DOMAIN/gateway (local, tunnel).
# GATEWAY_URL=http://localhost:4000

# --- Connections encryption and service auth ---
# Core seals connection secrets with ERXES_MASTER_KEY. Generate one with `pnpm erxes:secrets master`.
# ERXES_MASTER_KEY=
# Old master keys (comma separated) still used to open secrets after a rotation; new writes use ERXES_MASTER_KEY.
# ERXES_MASTER_KEY_PREVIOUS=
# Set on each service/plugin host that does not share ERXES_MASTER_KEY: `pnpm erxes:secrets service <name>`.
# ERXES_SERVICE_TOKEN=

# --- Sentry ---
# SENTRY_DSN=api_sentry_dsn
# SENTRY_ENVIRONMENT=api_sentry_environment_name
# SENTRY_TRACES_SAMPLE_RATE=0.1
# REACT_APP_SENTRY_DSN=ui_sentry_dsn
# REACT_APP_SENTRY_ENVIRONMENT=ui_sentry_environment_name
# RELEASE_VERSION=erxes-<git-sha-or-version>

# --- SaaS support messenger ---
# REACT_APP_SUPPORT_MESSENGER_INTEGRATION_ID=<integration _id>
# REACT_SUPPORT_WIDGETS_URL=https://w.officenext.erxes.io
