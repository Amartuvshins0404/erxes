{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2024",
    "lib": ["es2024", "dom"],
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "erxes-api-shared/*": ["../erxes-api-shared/src/*"]
    },
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
