{
  "name": "event_api",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "backend/plugins/event_api/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "backend/plugins/event_api",
        "commands": [
          "pnpm build"
        ]
      },
      "dependsOn": [
        "^build"
      ]
    },
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "typecheck",
        "build"
      ],
      "options": {
        "cwd": "backend/plugins/event_api",
        "command": "NODE_ENV=development node dist/src/main.js"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "backend/plugins/event_api",
        "command": "NODE_ENV=development pnpm dev"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec eslint backend/plugins/event_api"
      }
    },
    "docker-build": {
      "dependsOn": [
        "build"
      ],
      "command": "docker build -f backend/plugins/event_api/Dockerfile . -t erxes/erxes-next-event_api"
    }
  }
}
