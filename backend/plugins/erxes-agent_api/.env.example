# Mastra plugin — infrastructure environment reference.
#
# User-controlled feature switches are persisted per tenant and edited from the
# Agent General Settings page. Only deployment-level storage configuration
# remains in the root .env.

# Memory shares the plugin's MongoDB cluster and uses a dedicated database.
# MONGO_URL=mongodb://localhost:27017
# ERXES_AGENT_MEMORY_DB_PREFIX=erxes_mastra_memory
